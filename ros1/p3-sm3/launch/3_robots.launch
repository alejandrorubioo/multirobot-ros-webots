<launch>
<param name="robot_description" command="$(find xacro)/xacro.py $(find
turtlebot_description)/robots/kobuki_hexagons_asus_xtion_pro.urdf.xacro" />

<!-- <node pkg="tf2_ros" type="static_transform_publisher" name="turtlebot_tf_1" args="-1 -1 0 2 0 0 map Robot1/odom" />
<node pkg="tf2_ros" type="static_transform_publisher" name="turtlebot_tf_2" args="1 1 0 -2 0 0 map Robot2/odom" />
<node pkg="tf2_ros" type="static_transform_publisher" name="turtlebot_tf_3" args="1 -1 0 -2 0 0 map Robot3/odom" /> -->

<!-- BEGIN ROBOT 1-->
<group ns="robot1">
<param name="tf_prefix" value="Robot1" />
<include file="$(find sm3)/launch/one_robot.launch" >
<arg name="init_pose" value="-x -1 -y -1 -z 0 -R 0 -P 0 -Y 2" />
<arg name="robot_name" value="Robot1" />
</include>
</group>

<!-- BEGIN ROBOT 2 -->
<group ns="robot2">
<param name="tf_prefix" value="Robot2" />
<include file="$(find sm3)/launch/one_robot.launch" >
<arg name="init_pose" value="-x 1 -y 1 -z 0 -R 0 -P 0 -Y -2" />
<arg name="robot_name" value="Robot2" />
</include>
</group>

<!-- BEGIN ROBOT 3 -->
<group ns="robot3">
<param name="tf_prefix" value="Robot3" />
<include file="$(find sm3)/launch/one_robot.launch" >
<arg name="init_pose" value="-x 1 -y -1 -z 0 -R 0 -P 0 -Y -2" />
<arg name="robot_name" value="Robot3" />
</include>
</group>


</launch>